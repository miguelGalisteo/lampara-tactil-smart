# Copia este archivo como "secrets.yaml" en la misma carpeta y rellénalo.
# secrets.yaml NO se sube a git (ver .gitignore).

wifi_ssid: "TU_WIFI"
wifi_password: "TU_PASSWORD"

# Genera una clave nueva con: esphome secrets.yaml
# o con `openssl rand -base64 32` (debe ser de 32 bytes en base64)
api_encryption_key: "GENERA_UNA_CLAVE_DE_32_BYTES_EN_BASE64"

ota_password: "ELIGE_UNA_CONTRASENA_PARA_ACTUALIZACIONES_OTA"
